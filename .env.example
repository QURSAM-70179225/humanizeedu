# Copy to .env (never commit it or share it).
PORT=8080

# AI rewriting — Groq is used first. Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional backup provider (used only if Groq fails): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Max checks per visitor per hour (protects your Groq quota)
RATE_LIMIT_PER_HOUR=30

# Your main address once you have a custom domain, e.g. https://humanizeedu.com (leave empty until it works)
SITE_URL=

# "development" on your laptop, "production" on the live server
NODE_ENV=development

# Email shown on the Contact / Privacy / Terms pages
CONTACT_EMAIL=
# Buy Me a Coffee / Ko-fi link — shows the ☕ Support buttons
DONATE_URL=
# Search Console HTML-tag verification: only the content="..." value
GOOGLE_SITE_VERIFICATION=
# AdSense publisher ID, e.g. ca-pub-1234567890123456 — turns on ads and /ads.txt
ADSENSE_CLIENT=
