# Copy to .env (never commit it or share it).
PORT=8080

# AI rewriting — Groq is used first. Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional backup provider (used only if Groq fails): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Max checks per visitor per hour (protects your Groq quota)
RATE_LIMIT_PER_HOUR=30

# Your public address, used in sitemap.xml / robots.txt
SITE_URL=https://your-domain.com

# "development" on your laptop, "production" on the live server
NODE_ENV=development
